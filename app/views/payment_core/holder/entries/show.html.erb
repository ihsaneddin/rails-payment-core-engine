<h1>Entry</h1>

<p>
  <%= link_to "Back", holder_entries_path(holder_type: holder_type, holder_id: holder_id) %>
</p>

<dl>
  <dt>ID</dt>
  <dd><%= @entry.id %></dd>

  <dt>Type</dt>
  <dd><%= @entry.class.entry_type %></dd>

  <dt>State</dt>
  <dd><%= @entry.state %></dd>

  <dt>Payment Method</dt>
  <dd><%= @entry.payment_method&.display_name || @entry.payment_method&.method_type %></dd>

  <dt>Payable</dt>
  <dd><%= [@entry.payable_type, @entry.payable_id].compact.join("#") %></dd>

  <dt>Payer</dt>
  <dd><%= [@entry.payer_type, @entry.payer_id].compact.join("#") %></dd>
</dl>
