<h1>New Payment Method</h1>

<p><%= link_to "Back", admin_payment_methods_path %></p>

<%= form_with url: new_admin_payment_method_path, method: :get, local: true do %>
  <div>
    <%= label_tag :type, "Type" %>
    <%= select_tag :type, options_for_select(payment_method_types_for_select, payment_method_type_value), onchange: "this.form.submit()" %>
  </div>
  <noscript><%= submit_tag "Change Type" %></noscript>
<% end %>

<%= render "form", payment_method: @payment_method %>
