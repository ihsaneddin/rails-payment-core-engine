<h1>Payment Methods</h1>

<p><%= link_to "New Payment Method", new_admin_payment_method_path %></p>

<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Type</th>
      <th>Display Name</th>
      <th>Holder</th>
      <th>Active</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @payment_methods.each do |payment_method| %>
      <tr>
        <td><%= payment_method.id %></td>
        <td><%= payment_method.method_type %></td>
        <td><%= payment_method.display_name %></td>
        <td><%= [payment_method.holder_type, payment_method.holder_id].compact.join("#") %></td>
        <td><%= payment_method.active? %></td>
        <td>
          <%= link_to "Show", admin_payment_method_path(payment_method) %>
          <%= link_to "Edit", edit_admin_payment_method_path(payment_method) %>
          <%= link_to "Delete", admin_payment_method_path(payment_method), method: :delete, data: { confirm: "Are you sure?" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<% grouped_payment_methods = @payment_methods.group_by(&:method_type) %>
<% grouped_payment_methods.each do |method_type, payment_methods| %>
  <% actions = collective_processor_actions_for(method_type, scope: @payment_methods) %>
  <% next if actions.blank? %>

  <h2><%= method_type.humanize %> Actions</h2>
  <% actions.each do |processor_action| %>
    <% processor = collection_processor_for(method_type, scope: @payment_methods) %>
    <%= form_with url: admin_payment_method_collective_processor_action_path(method_type: method_type, processor_action: processor_action.to_s.delete_prefix("collective_")), local: true do %>
      <div>
        <%= label_tag :payment_method_ids, "Payment Methods" %>
        <%= select_tag "payment_method_ids[]", options_for_select(payment_method_options_for_select(payment_methods, method_type: method_type)), multiple: true %>
      </div>

      <% processor_param_fields_for(processor, processor_action.to_s.delete_prefix("collective_"), type: :collective).each do |field| %>
        <% next if field[:name] == "payment_method_ids" %>
        <div>
          <%= label_tag processor_field_input_name(field), field[:label] %>
          <% case field[:input] %>
          <% when :payable_type %>
            <%= select_tag processor_field_input_name(field), options_for_select(payable_type_options_for_select) %>
          <% when :payable_id %>
            <%= select_tag processor_field_input_name(field), grouped_options_for_select(payable_grouped_options_for_select) %>
          <% when :checkbox %>
            <%= check_box_tag processor_field_input_name(field), "1", false %>
          <% when :json %>
            <%= text_area_tag "#{field[:name]}_json", "", rows: 4 %>
          <% else %>
            <%= text_field_tag processor_field_input_name(field) %>
          <% end %>
        </div>
      <% end %>

      <div>
        <%= submit_tag processor_action.to_s.delete_prefix("collective_").humanize %>
      </div>
    <% end %>
  <% end %>
<% end %>
