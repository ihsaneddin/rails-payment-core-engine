<section>
  <p>Dummy Admin</p>
  <h1>Payment Entries</h1>
  <p><%= link_to "Back to Payment Methods", admin_payment_methods_path %></p>
</section>

<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Type</th>
      <th>State</th>
      <th>Payment Method</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @entries.each do |entry| %>
      <tr>
        <td><%= entry.id %></td>
        <td><%= entry.class.entry_type %></td>
        <td><%= entry.state %></td>
        <td><%= entry.payment_method&.display_name || entry.payment_method&.method_type %></td>
        <td><%= link_to "Open", admin_entry_path(id: entry.id) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
